{
  "app_name": "Stratum",
  "ui_mode": "panel",
  "panels": ["dashboard", "clipboard", "prompts", "links", "tts"],
  "hotkeys": {
    "clipboard": "Ctrl+Alt+C",
    "prompts": "Ctrl+Alt+P",
    "links": "Ctrl+Alt+L",
    "tts": "Ctrl+Alt+T",
    "gui": "Ctrl+Alt+G",
    "rewrite": "Ctrl+Space"
  },
  "clipboard": {
    "slots": 75,
    "store_file": "05_logs/clipboard_slots.json"
  },
  "tts": {
    "voice": "",
    "rate": 0
  },
  "openai": {
    "model": "gpt-4.1-mini",
    "api_key_env": "OPENAI_API_KEY",
    "rewrite_instruction": "Rewrite this text into coherent prose with corrected punctuation, sentence boundaries, capitalization, and spelling. Preserve meaning. Do not add new claims or extra content."
  }
}
